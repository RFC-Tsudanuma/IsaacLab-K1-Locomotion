# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IsaacLab / Hydra
outputs/

# logs/ は基本的に追跡しないが、転移学習の起点にする walk phase の checkpoint だけは
# リポジトリに含める（--load_pretrained で walk_kick / walk_pass の両方から参照するため）。
#
# NOTE: git は除外されたディレクトリの中を走査しないので、`logs/` のように親ごと
#       除外していると中のファイルを `!` で再包含できない。階層ごとに
#       「`*` で中身を除外 → `!` でディレクトリだけ復活」を繰り返す必要がある。
logs/*
!logs/rsl_rl/
logs/rsl_rl/*
!logs/rsl_rl/k1_walk_kick_walk_phase/
logs/rsl_rl/k1_walk_kick_walk_phase/*
!logs/rsl_rl/k1_walk_kick_walk_phase/2026-07-17_12-15-06/
logs/rsl_rl/k1_walk_kick_walk_phase/2026-07-17_12-15-06/*
!logs/rsl_rl/k1_walk_kick_walk_phase/2026-07-17_12-15-06/model_4999.pt

# 膝同士の接触の罰 (knee_close_penalty, commit 7c3f14d) を入れた後の walk phase。
# 上の 2026-07-17 の run はこの報酬項が存在しない時代のものなので、膝の接触を
# 気にするタスク (walk_lob など) の --load_pretrained 元にはこちらを使うこと。
# 歩行品質自体は 2 つの run でほぼ同等 (episode_length 995 vs 988)。
!logs/rsl_rl/k1_walk_kick_walk_phase/2026-08-03_11-22-52/
logs/rsl_rl/k1_walk_kick_walk_phase/2026-08-03_11-22-52/*
!logs/rsl_rl/k1_walk_kick_walk_phase/2026-08-03_11-22-52/model_4999.pt

# loop_shoot の起点 checkpoint（vz_sat=3.7 / 速度帯 (5.5,7.0) の再学習の --load_pretrained 元）。
!logs/rsl_rl/k1_walk_loop_shoot/
logs/rsl_rl/k1_walk_loop_shoot/*
!logs/rsl_rl/k1_walk_loop_shoot/2026-07-23_00-44-11/
logs/rsl_rl/k1_walk_loop_shoot/2026-07-23_00-44-11/*
!logs/rsl_rl/k1_walk_loop_shoot/2026-07-23_00-44-11/model_10700.pt

# vz_sat=4.5 / φ_sat=45° + ボール物性 DR の run。apex 平均 0.81-0.84 (K1 身長 0.80 超え)。
!logs/rsl_rl/k1_walk_loop_shoot/2026-07-24_13-59-06/
logs/rsl_rl/k1_walk_loop_shoot/2026-07-24_13-59-06/*
!logs/rsl_rl/k1_walk_loop_shoot/2026-07-24_13-59-06/model_14900.pt

# loop_pass の checkpoint。全方位版 (Walk-Loop-Pass-360) の --load_pretrained 元。
# NOTE: ディレクトリ名は experiment 名を k1_walk_loop_pass にリネームする前の旧名。
!logs/rsl_rl/k1_walk_loop/
logs/rsl_rl/k1_walk_loop/*
!logs/rsl_rl/k1_walk_loop/2026-07-20_10-33-30/
logs/rsl_rl/k1_walk_loop/2026-07-20_10-33-30/*
!logs/rsl_rl/k1_walk_loop/2026-07-20_10-33-30/model_4600.pt

# loop_pass_360 の checkpoint。実機で動作確認済み（指令 2 m/s → 飛距離約 2 m）。
# ロングパス (Walk-Long-Pass) の --load_pretrained 元。
!logs/rsl_rl/k1_walk_loop_pass_360/
logs/rsl_rl/k1_walk_loop_pass_360/*
!logs/rsl_rl/k1_walk_loop_pass_360/2026-08-03_22-13-23/
logs/rsl_rl/k1_walk_loop_pass_360/2026-08-03_22-13-23/*
!logs/rsl_rl/k1_walk_loop_pass_360/2026-08-03_22-13-23/model_4999.pt

# walk_kick_360 の checkpoint。実機で動作確認済み（全力キックで飛距離約 20 m、
# sim 実測 v_ball ≈ 6.0 m/s）。ミドルキック (Walk-Mid-Kick) の --load_pretrained 元。
!logs/rsl_rl/k1_walk_kick_360/
logs/rsl_rl/k1_walk_kick_360/*
!logs/rsl_rl/k1_walk_kick_360/2026-08-08_16-48-06/
logs/rsl_rl/k1_walk_kick_360/2026-08-08_16-48-06/*
!logs/rsl_rl/k1_walk_kick_360/2026-08-08_16-48-06/model_2800.pt

# long_pass の checkpoint。実機で動作確認済み (5-10 m の転がしパス)。
# sim 実測 (iter 4000): kick_rate 0.996 / kick_vel_ratio 0.898 / kick_dir_error 3.8°、
# 速度帯は終点 (3.2, 5.0) に到達済み。
# ボール物性 DR 版 (Walk-Long-Pass-DR) の --load_pretrained 元。
!logs/rsl_rl/k1_walk_long_pass/
logs/rsl_rl/k1_walk_long_pass/*
!logs/rsl_rl/k1_walk_long_pass/2026-08-09_11-03-31/
logs/rsl_rl/k1_walk_long_pass/2026-08-09_11-03-31/*
!logs/rsl_rl/k1_walk_long_pass/2026-08-09_11-03-31/model_4000.pt

# middle_kick_360 の checkpoint (stage 3, middle)。帯 (3.2, 4.5) m/s = 実機 5-10 m 相当。
# 知覚ノイズ版 (Walk-Middle-Kick-360-Noisy-Ball, stage 4) の --load_pretrained 元。
!logs/rsl_rl/k1_walk_middle_kick_360/
logs/rsl_rl/k1_walk_middle_kick_360/*
!logs/rsl_rl/k1_walk_middle_kick_360/2026-08-15_07-54-29/
logs/rsl_rl/k1_walk_middle_kick_360/2026-08-15_07-54-29/*
!logs/rsl_rl/k1_walk_middle_kick_360/2026-08-15_07-54-29/model_4999.pt

# walk_kick_360_weak の checkpoint (stage 3, weak)。カリキュラム (0/500/1500/3000) は
# 走り切った後の状態 (strong=0 / σ=0.35 / overshoot 満額)。
# sim 実測 (iter 3000): kick_rate 0.973 / kick_vel_ratio 1.098 / kick_dir_error 6.6°、
# 低指令域は成功率 0.96 / 追従率 1.40 (まだ蹴りすぎ)。
# 5000 まで延長する --resume 元、および知覚ノイズ版
# (Walk-Kick-360-Weak-Noisy-Ball, stage 4) の --load_pretrained 元。
!logs/rsl_rl/k1_walk_kick_360_weak/
logs/rsl_rl/k1_walk_kick_360_weak/*
!logs/rsl_rl/k1_walk_kick_360_weak/2026-08-14_13-28-13/
logs/rsl_rl/k1_walk_kick_360_weak/2026-08-14_13-28-13/*
!logs/rsl_rl/k1_walk_kick_360_weak/2026-08-14_13-28-13/model_3000.pt

# ball_avoid (観測スロット3をボール3D位置に、Ball Avoidance を実行圧解釈に差し替えた系統)
# の stage 2 の起点。スロット3の意味が違うので既存の walk phase checkpoint は流用できない。
!logs/rsl_rl/k1_walk_kick_ball_avoid_walk_phase/
logs/rsl_rl/k1_walk_kick_ball_avoid_walk_phase/*
!logs/rsl_rl/k1_walk_kick_ball_avoid_walk_phase/2026-08-17_15-29-56/
logs/rsl_rl/k1_walk_kick_ball_avoid_walk_phase/2026-08-17_15-29-56/*
!logs/rsl_rl/k1_walk_kick_ball_avoid_walk_phase/2026-08-17_15-29-56/model_4999.pt

