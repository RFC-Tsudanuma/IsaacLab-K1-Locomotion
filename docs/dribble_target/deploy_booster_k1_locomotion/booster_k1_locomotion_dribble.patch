+            "dribble model " + path + ": obs_history must be (1, H, " +
+            std::to_string(db::OBS_DIM) + ") with fixed H");
+    }
+    const auto cshape = session.GetInputTypeInfo(cmd_idx)
+                            .GetTensorTypeAndShapeInfo().GetShape();
+    if (cshape.size() != 2 || cshape[1] != db::CMD_DIM) {
