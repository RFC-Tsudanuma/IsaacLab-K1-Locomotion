+    Ort::AllocatorWithDefaultOptions alloc;
+    int hist_idx = -1, cmd_idx = -1;
+    for (size_t i = 0; i < session.GetInputCount(); ++i) {
+        const std::string name(session.GetInputNameAllocated(i, alloc).get());
