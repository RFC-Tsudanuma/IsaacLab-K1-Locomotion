index 0000000..e69b69e
--- /dev/null
+++ b/scripts/test_dribble_mujoco.py
@@ -0,0 +1,333 @@
+#!/usr/bin/env python3
+"""ドリブルポリシーを MuJoCo sim (mujoco_sim_node_cpp + rl_policy_isaaclab_node_cpp + vision_filter)
+でいくつかの経路について試し、成功・転倒・所要時間を集計する。
+
+前提: dribble_test_sim.launch.py (headless 可) と vision_filter (sim_robot_id:=1) が動いていること。
+    python3 test_dribble_mujoco.py --shapes "straight l_shape s_curve" --repeats 2
+
+各試行: ロボットを初期姿勢に戻す → 静止を待つ → ボールをロボット正面 ball_ahead [m] に置く →
+/soccer_dribble_cmd_1 にワールド座標のウェイポイント列 (ボール基準の形をロボットの向きに回したもの) を送る
+→ 成功・転倒・時間切れまで観測 → 空の経路を送って Walk に戻す。
+判定は /mujoco_sim/world_state の真値だけで行う (成功 = 学習と同じく、最終目標から
+ボールとロボットの両方が 1.0 m 以内)。
+"""
+import argparse
+import json
+import math
+import sys
+import time
+
+import rclpy
+from geometry_msgs.msg import Point, PoseStamped, Twist
+from nav_msgs.msg import Path
+from sensor_msgs.msg import JointState
+from rclpy.node import Node
+
+from futbol_msgs.msg import SimSetRobotPose, SimWorldState
+
+# ボール位置を原点、ロボットの正面を +x とした経路 (最後が目標) [m]。
+# 学習のレベルに近い形を、曲がりの小さいものから並べている。
+SHAPES = {
+    'straight': [(3.0, 0.0)],
+    'curve': [(1.5, 0.2), (3.0, 0.8), (4.2, 1.8)],
+    'l_shape': [(3.0, 0.0), (3.0, 2.5)],
+    's_curve': [(1.5, 0.6), (3.0, -0.6), (4.5, 0.6), (6.0, 0.0)],
+    'polyline': [(1.5, 0.0), (2.8, 0.7), (3.6, 1.9)],
+    'v_turn': [(3.0, 0.0), (1.0, 1.4)],
+}
+
+
+def _figure8(radius, n_per_loop=12):
+    """学習の Level10 (commands.py の figure8) と同じ: 半径 R の円を始点から左回り → 右回りで 1 周ずつ。終点 = 始点。"""
+    ts = [2 * math.pi * k / n_per_loop for k in range(1, n_per_loop + 1)]
+    loop1 = [(radius * math.sin(t), radius - radius * math.cos(t)) for t in ts]
+    loop2 = [(radius * math.sin(t), -(radius - radius * math.cos(t))) for t in ts]
+    return loop1 + loop2
+
+
+# 学習の半径は U(1.2, 1.8) m。真ん中の 1.5 m (周長 約 19 m) にする。--shapes で明示したときだけ使う
+# (既定の全コースには入れない。時間がかかるので --timeout を 60 秒程度にする)。
+EXTRA_SHAPES = {'figure8': _figure8(1.5)}
+WAYPOINT_REACH_M = 0.3   # 学習の通過判定 (k1_dribble_constants.hpp と同じ)
+PASS_LINE_MAX_M = 1.0
+SUCCESS_RADIUS_M = 1.0
+SPEED_WINDOW_S = 0.5  # 速さは 0.5 秒平均の水平速度 (学習側の評価と同じ定義)
+# 関節速度を見る関節と、Isaac の学習で PhysX にかかっている上限 [rad/s] (Booster 公式 URDF の velocity)
+WATCHED_JOINTS = {'Hip_Pitch': 7.1, 'Knee_Pitch': 12.5}
+
+
+def speed_series(samples):
+    """(t, x, y) の列から、各時刻の 0.5 秒平均の速さ (t, v) の列を作る。"""
+    out = []
+    j = 0
+    for t, x, y in samples:
+        while j + 1 < len(samples) and samples[j + 1][0] <= t - SPEED_WINDOW_S:
+            j += 1
+        tj, xj, yj = samples[j]
+        if t - tj >= SPEED_WINDOW_S * 0.8:
+            out.append((t, math.hypot(x - xj, y - yj) / (t - tj)))
+    return out
+
+
+def speed_stats(samples, t_start, t_end, outcome):
+    """ドリブル中 (ボールが動き出してから終わるまで) の速さの指標。"""
+    series = [(t, v) for t, v in speed_series(samples) if t_start is not None and t_start <= t <= t_end]
+    if not series:
+        return {}
+    vs = [v for _, v in series]
+    stats = dict(v_mean=sum(vs) / len(vs), v_peak=max(vs),
+                 over_1_0=sum(v > 1.0 for v in vs) / len(vs), over_1_2=sum(v > 1.2 for v in vs) / len(vs))
+    if outcome == 'fall':
+        pre = [v for t, v in series if t_end - 1.0 <= t <= t_end - 0.5]
+        last2 = [v for t, v in series if t >= t_end - 2.0]
+        stats['v_fall_pre'] = sum(pre) / len(pre) if pre else None
+        stats['v_fall_peak2s'] = max(last2) if last2 else None
+    return stats
+FALL_TRUNK_HEIGHT_M = 0.35
+STANDING_TRUNK_HEIGHT_M = 0.42  # 試行を始めてよい胴体の高さ (立位は約 0.5 m、歩行中も 0.44 m 以上)
+
+
+class DribbleTester(Node):
+    def __init__(self):
+        super().__init__('dribble_tester')
+        self.ws = None
+        self.create_subscription(SimWorldState, '/mujoco_sim/world_state', self._on_ws, 10)
+        self.pub_ball = self.create_publisher(Point, '/mujoco_sim/set_ball_pose', 10)
+        self.pub_robot = self.create_publisher(SimSetRobotPose, '/mujoco_sim/set_robot_pose', 10)
+        self.pub_path = self.create_publisher(Path, '/soccer_dribble_cmd_1', 10)
+        self.pub_cmd = self.create_publisher(Twist, '/cmd_vel_1', 10)
+        self.joint_samples = None  # 試行中だけ (t, {関節名: |dq|}) を貯める
+        self.create_subscription(JointState, '/booster/joint_states', self._on_joints, 50)
+
+    def _on_joints(self, msg):
+        if self.joint_samples is None:
+            return
+        speeds = {}
+        for name, vel in zip(msg.name, msg.velocity):
+            for joint in WATCHED_JOINTS:
+                if name.endswith(joint):
+                    speeds.setdefault(joint, []).append(abs(vel))
+        if speeds:
+            self.joint_samples.append((time.monotonic(), {j: max(v) for j, v in speeds.items()}))
+
+    def _on_ws(self, msg):
+        self.ws = msg
+
+    def wait(self, seconds):
+        end = time.monotonic() + seconds
+        while time.monotonic() < end:
+            rclpy.spin_once(self, timeout_sec=0.02)
+
+    def robot(self):
+        return self.ws.robots[0] if self.ws and self.ws.robots else None
+
+    def send_path(self, points):
+        msg = Path()
+        msg.header.frame_id = 'field'
+        msg.header.stamp = self.get_clock().now().to_msg()
+        for x, y in points:
+            ps = PoseStamped()
+            ps.header = msg.header
+            ps.pose.position.x = x
+            ps.pose.position.y = y
+            ps.pose.orientation.w = 1.0
+            msg.poses.append(ps)
+        self.pub_path.publish(msg)
+
+    def trial(self, shape, ball_ahead, timeout_s, resend_hz, dump=None):
+        # 1) 経路を取り消し、ロボットを初期姿勢へ戻して静止を待つ。
+        #    前の試行で転倒した直後はリセット後にまた倒れることがあるので、立っているのを
+        #    確かめてから始める (倒れたままだと開始直後に「転倒」と数えてしまう)。
+        self.send_path([])
+        r = None
+        for _ in range(3):
+            rp = SimSetRobotPose(); rp.robot_id = 1; rp.to_initial_pose = True
+            self.pub_robot.publish(rp)
+            self.pub_cmd.publish(Twist())
+            far = Point(); far.x = 5.0; far.y = 5.0; far.z = 0.0
+            self.pub_ball.publish(far)
+            self.wait(3.0)
+            r = self.robot()
+            if r is not None and r.trunk_height > STANDING_TRUNK_HEIGHT_M:
+                break
+        if r is None:
+            return dict(shape=shape, error='no world_state')
+        if r.trunk_height <= STANDING_TRUNK_HEIGHT_M:
+            return dict(shape=shape, error='robot not standing after reset')
+        c, s = math.cos(r.theta), math.sin(r.theta)
+        # 2) ボールをロボット正面に置く
+        bx, by = r.x + c * ball_ahead, r.y + s * ball_ahead
+        p = Point(); p.x = bx; p.y = by; p.z = 0.0
+        self.pub_ball.publish(p)
+        self.wait(1.5)  # vision_filter が追従するのを待つ
+        # 3) ボール基準の形をワールド座標へ
+        path = [(bx + c * fx - s * fy, by + s * fx + c * fy) for fx, fy in SHAPES[shape]]
+        goal = path[-1]
+        # 4) 経路を送り続けながら観測 (戦略と同じく毎周期送る。中身は同じなので再始点化はされない)
+        t0 = time.monotonic(); next_send = t0
+        min_trunk = 9.9; first_move = None; outcome = 'timeout'; t_end = None
+        samples = []  # (t, x, y) ロボットの水平位置
+        ball_track = []  # (UNIX 時刻, x, y) ボールの真値。推論ノードのログと時刻で突き合わせる
+        ball_robot_dist = []  # (t, ロボットとボールの水平距離) キープの指標
+        start_ball_goal = math.hypot(bx - goal[0], by - goal[1])
+        # 学習と同じく、最後のウェイポイントに進んでから成功を判定する (8 の字は終点 = 始点のため)。
+        # 進め方は推論ノード・学習と同じ通過判定をボールの真値で行う。
+        points = [(bx, by)] + path
+        wp = 0
+        max_ball_goal = start_ball_goal
+        self.joint_samples = []
+        while time.monotonic() - t0 < timeout_s:
+            now = time.monotonic()
+            if now >= next_send:
+                self.send_path(path)
+                next_send = now + 1.0 / resend_hz
+            rclpy.spin_once(self, timeout_sec=0.02)
+            rr = self.robot()
+            if self.ws is None or rr is None:
+                continue
+            bp = self.ws.ball_position
+            min_trunk = min(min_trunk, rr.trunk_height)
+            samples.append((now - t0, rr.x, rr.y))
+            ball_track.append((time.time(), bp.x, bp.y))
+            ball_robot_dist.append((now - t0, math.hypot(bp.x - rr.x, bp.y - rr.y)))
+            max_ball_goal = max(max_ball_goal, math.hypot(bp.x - goal[0], bp.y - goal[1]))
+            if first_move is None and math.hypot(bp.x - bx, bp.y - by) > 0.1:
+                first_move = now - t0
+            if rr.trunk_height < FALL_TRUNK_HEIGHT_M:
+                outcome = 'fall'; t_end = now - t0
+                break
+            if wp < len(path) - 1:
+                (px, py), (wx, wy) = points[wp], points[wp + 1]
+                seg = math.hypot(wx - px, wy - py)
+                dist_w = math.hypot(bp.x - wx, bp.y - wy)
+                along = ((bp.x - wx) * (wx - px) + (bp.y - wy) * (wy - py)) / seg if seg > 1e-6 else 0.0
+                if dist_w < WAYPOINT_REACH_M or (along >= 0.0 and dist_w < PASS_LINE_MAX_M):
+                    wp += 1
+            if (wp == len(path) - 1 and math.hypot(bp.x - goal[0], bp.y - goal[1]) < SUCCESS_RADIUS_M and
+                    math.hypot(rr.x - goal[0], rr.y - goal[1]) < SUCCESS_RADIUS_M):
+                outcome = 'success'; t_end = now - t0
+                break
+        bp = self.ws.ball_position
+        self.send_path([])
+        stats = speed_stats(samples, first_move, t_end if t_end is not None else timeout_s, outcome)
+        stats.update(joint_stats(self.joint_samples, t0, first_move,
+                                 t_end if t_end is not None else timeout_s))
+        self.joint_samples = None
+        # キープ: ドリブル中 (ボールが動き出してから終わるまで) のロボットとボールの距離
+        t_stop = t_end if t_end is not None else timeout_s
+        stats['keep_dists'] = [round(dd, 3) for tt, dd in ball_robot_dist
+                               if first_move is not None and first_move <= tt <= t_stop][::5]
+        # 押し戻し: ボール→目標の距離が、途中で開始時より (0.1 m の余裕を超えて) 大きくなった
+        stats['pushed_back'] = max_ball_goal > start_ball_goal + 0.1
+        if dump is not None:
+            dump.write(json.dumps(dict(shape=shape, outcome=outcome, path=path, ball_start=(bx, by),
+                                       ball_track=ball_track[::2])) + '\n')
+            dump.flush()
+        return dict(shape=shape, outcome=outcome, wp=f"{wp}/{len(path) - 1}", t_end=t_end, t_first_move=first_move,
+                    ball_goal=math.hypot(bp.x - goal[0], bp.y - goal[1]), min_trunk=min_trunk, **stats)
+
+
+def joint_stats(joint_samples, t0, t_start, t_end):
+    """ドリブル中の関節速度 (左右の大きい方) の最大値と、Isaac の上限を超えた割合。"""
+    if t_start is None:
+        return {}
+    window = [js for t, js in joint_samples if t_start <= t - t0 <= t_end]
+    out = {}
+    for joint, cap in WATCHED_JOINTS.items():
+        vals = [js[joint] for js in window if joint in js]
+        if vals:
+            key = joint.lower()
+            out[f'{key}_max'] = max(vals)
+            out[f'{key}_over_cap'] = sum(v > cap for v in vals) / len(vals)
+            out[f'{key}_n'] = len(vals)
+            # 転倒の 1 秒前までに区切った値 (倒れていく最中の脚の振りを除く)
+            pre = [js[joint] for t, js in joint_samples
+                   if t_start <= t - t0 <= t_end - 1.0 and joint in js]
+            if pre:
+                out[f'{key}_max_pre1s'] = max(pre)
+                out[f'{key}_over_cap_pre1s'] = sum(v > cap for v in pre) / len(pre)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--shapes', default=' '.join(SHAPES), help='試す形 (空白区切り): ' + ' '.join(SHAPES))
+    ap.add_argument('--repeats', type=int, default=2)
+    ap.add_argument('--ball-ahead', type=float, default=0.8, help='ボールを置くロボット正面の距離 [m] (開始窓 0.6〜1.0)')
+    ap.add_argument('--timeout', type=float, default=40.0)
+    ap.add_argument('--resend-hz', type=float, default=10.0, help='経路を送り直す頻度 (戦略の周期を模す)')
+    ap.add_argument('--warmup', type=float, default=8.0, help='起動直後に policy が Walk に入るまで待つ秒数')
+    ap.add_argument('--dump', default=None, help='各試行の経路とボールの真値の軌跡を JSON Lines で書き出す先')
+    args = ap.parse_args()
+    shapes = args.shapes.split()
+    SHAPES.update({k: v for k, v in EXTRA_SHAPES.items() if k in shapes})
+    unknown = [s for s in shapes if s not in SHAPES]
+    if unknown:
+        print('ERROR: unknown shapes', unknown, flush=True)
+        sys.exit(2)
+    rclpy.init()
+    node = DribbleTester()
+    node.wait(args.warmup)
+    if node.ws is None:
+        print('ERROR: /mujoco_sim/world_state not received', flush=True)
+        sys.exit(2)
+    rows = []
+    dump = open(args.dump, 'w') if args.dump else None
+    for rep in range(args.repeats):
+        for shape in shapes:
+            res = node.trial(shape, args.ball_ahead, args.timeout, args.resend_hz, dump)
+            rows.append(res)
+            print('TRIAL', rep, {k: (round(v, 2) if isinstance(v, float) else v)
+                                 for k, v in res.items() if k != 'keep_dists'}, flush=True)
+    ok = [r for r in rows if 'error' not in r]
+    n = max(1, len(ok))
+    print('SUMMARY n=%d success=%.2f fall=%.2f timeout=%.2f pushed_back=%.2f' % (
+        len(ok), sum(r['outcome'] == 'success' for r in ok) / n,
+        sum(r['outcome'] == 'fall' for r in ok) / n,
+        sum(r['outcome'] == 'timeout' for r in ok) / n,
+        sum(bool(r.get('pushed_back')) for r in ok) / n), flush=True)
+    for shape in shapes:
+        sel = [r for r in ok if r['shape'] == shape]
+        times = sorted(r['t_end'] for r in sel if r['outcome'] == 'success')
+        print('  %-9s success %d/%d fall %d  t_success_med=%s' % (
+            shape, sum(r['outcome'] == 'success' for r in sel), len(sel),
+            sum(r['outcome'] == 'fall' for r in sel),
+            round(times[len(times) // 2], 1) if times else None), flush=True)
+    print_speed_summary(ok)
+    dists = sorted(d for r in ok for d in r.get('keep_dists', []))
+    if dists:
+        print('KEEP ball-robot distance p10/p50/p90 = %s / %s / %s m, >=1.0 m: %.3f' % (
+            _quantile(dists, .1), _quantile(dists, .5), _quantile(dists, .9),
+            sum(d >= 1.0 for d in dists) / len(dists)), flush=True)
+    node.destroy_node(); rclpy.shutdown()
+
+
+def _quantile(values, q):
+    values = sorted(v for v in values if v is not None)
+    return round(values[min(len(values) - 1, int(q * len(values)))], 2) if values else None
+
+
+def print_speed_summary(rows):
+    """学習側の評価と同じ指標で、速さをまとめる。"""
+    succ = [r for r in rows if r['outcome'] == 'success' and 'v_mean' in r]
+    falls = [r for r in rows if r['outcome'] == 'fall' and 'v_mean' in r]
+    print('SPEED success(n=%d): mean_med=%s peak_p50=%s peak_p90=%s over1.0=%s over1.2=%s' % (
+        len(succ), _quantile([r['v_mean'] for r in succ], 0.5),
+        _quantile([r['v_peak'] for r in succ], 0.5), _quantile([r['v_peak'] for r in succ], 0.9),
+        _quantile([r['over_1_0'] for r in succ], 0.5), _quantile([r['over_1_2'] for r in succ], 0.5)), flush=True)
+    for joint, cap in WATCHED_JOINTS.items():
+        key = joint.lower()
+        sel = [r for r in rows if f'{key}_n' in r]
+        n_total = sum(r[f'{key}_n'] for r in sel)
+        over = sum(r[f'{key}_over_cap'] * r[f'{key}_n'] for r in sel)
+        print('JOINT %s: max_med=%s max_p90=%s over_%.1f=%.3f (all samples) | fall trials max_med=%s' % (
+            joint, _quantile([r[f'{key}_max'] for r in sel], 0.5), _quantile([r[f'{key}_max'] for r in sel], 0.9),
+            cap, over / max(n_total, 1),
+            _quantile([r[f'{key}_max'] for r in sel if r['outcome'] == 'fall'], 0.5)), flush=True)
+    print('SPEED fall(n=%d): peak_2s_before_med=%s mean_1.0-0.5s_before_med=%s' % (
+        len(falls), _quantile([r.get('v_fall_peak2s') for r in falls], 0.5),
+        _quantile([r.get('v_fall_pre') for r in falls], 0.5)), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/k1_dribble_constants.hpp b/src/k1_dribble_constants.hpp
new file mode 100644
index 0000000..3548985
--- /dev/null
+++ b/src/k1_dribble_constants.hpp
@@ -0,0 +1,72 @@
+#pragma once
+/**
+ * K1 dribble policy constants
+ * (IsaacLab-K1-Locomotion, tasks/manager_based/dribble_target, Stage2).
+ * Source of assets/k1_dribble_target_2026-11-01_12-04-42_model_74991.onnx: branch
+ * feat/dribble_target_rebuild, run logs/rsl_rl/k1_dribble_target/2026-11-01_12-04-42
+ * (the ball observations go through an imitation of vision_filter's ball filter).
+ * (The kick policies in assets/ are trained elsewhere, not in that repository.)
+ *
+ * The policy is the walk policy fine-tuned on dribbling, so the first 49
+ * channels of a frame are exactly the walk frame (k1_constants_isaaclab.hpp);
+ * 10 dribble channels follow. Values mirror the exported spec JSON
+ * (assets/k1_dribble_target_*_spec.json).
+ *
+ * ONNX I/O (history_policy_exporter, batch 1, all axes fixed):
+ *   command     (1, 3)        always 0 (the walk velocity command is fixed to
+ *                             zero in Stage2)
+ *   obs_history (1, H, 59)    rows = frames, oldest -> newest
+ *   actions     (1, 12)       q_target = q_default + 0.5 * action
+ *
+ * Frame layout (59 = 49 walk + 10 dribble):
+ *   [ 0: 3]  base_ang_vel          gyro, body frame
+ *   [ 3: 6]  projected_gravity
+ *   [ 6: 9]  velocity_commands     always 0
+ *   [ 9:21]  joint_pos_rel         12 legs, relative to default
+ *   [21:33]  joint_vel             12 legs
+ *   [33:45]  last_action           12 legs, previous raw output
+ *   [45:49]  gait_phase            sin/cos left, sin/cos right; 1.8 Hz, never
+ *                                  zeroed (unlike the walk's stand-still gate)
+ *   [49:51]  target_pos_rel        current waypoint - robot, body yaw frame
