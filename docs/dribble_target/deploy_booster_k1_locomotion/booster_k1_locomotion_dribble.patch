index 0000000..26cfc6a
--- /dev/null
+++ b/scripts/analyze_dribble_pass_timing.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""ドリブルのウェイポイントを推論ノードが進めた瞬間に、ボールが本当はどこにいたかを集計する。
+
+test_dribble_mujoco.py --dump で書き出した経路・ボールの真値と、推論ノードのログ
+(sim.log の "[Dribble] waypoint k/n passed") を UNIX 時刻で突き合わせる。
+
+    python3 analyze_dribble_pass_timing.py <LOG_DIR>   # LOG_DIR に sim.log と trials.jsonl
+
+指標 (ウェイポイント W、1 つ前の点 P、入ってきた区間の向き u = (W - P)/|W - P|、ボールの真値 B):
+  along = (B - W)・u   … 負なら「まだ垂直な線の手前」= 早めに進めた、正なら越えてから進めた
+  dist  = |B - W|
+学習では真値で判定するので、along が負に大きいほど / 正に大きいほど学習とずれている。
+"""
+import bisect
+import json
+import math
+import re
+import sys
+
+PASS_RE = re.compile(r'\[(\d+\.\d+)\] \[rl_policy_isaaclab_node\]: \[Dribble\] waypoint (\d+)/(\d+) passed \((\w+)')
+
+
+def main():
+    log_dir = sys.argv[1]
+    trials = [json.loads(line) for line in open(f'{log_dir}/trials.jsonl')]
+    passes = [(float(m[1]), int(m[2]), int(m[3]), m[4])
+              for m in (PASS_RE.search(line) for line in open(f'{log_dir}/sim.log', errors='replace')) if m]
+    rows = []
+    for tr in trials:
+        track = tr['ball_track']
+        if not track:
+            continue
+        times = [t for t, _, _ in track]
+        t_lo, t_hi = times[0], times[-1]
+        points = [tuple(tr['ball_start'])] + [tuple(p) for p in tr['path']]
+        for t, k, n, kind in passes:
+            if not (t_lo <= t <= t_hi) or n != len(tr['path']):
+                continue
+            i = min(bisect.bisect_left(times, t), len(track) - 1)
+            _, bx, by = track[i]
+            px, py = points[k - 1]
+            wx, wy = points[k]
+            seg = math.hypot(wx - px, wy - py)
+            ux, uy = (wx - px) / seg, (wy - py) / seg
+            rows.append(dict(shape=tr['shape'], kind=kind,
+                             along=(bx - wx) * ux + (by - wy) * uy, dist=math.hypot(bx - wx, by - wy)))
+    if not rows:
+        print('no waypoint passes found')
+        return
+
+    def q(vals, p):
+        vals = sorted(vals)
+        return round(vals[min(len(vals) - 1, int(p * len(vals)))], 2)
+
+    for kind in ('reached', 'crossed', None):
+        sel = [r for r in rows if kind is None or r['kind'] == kind]
+        if not sel:
+            continue
+        al = [r['along'] for r in sel]
+        print('%-8s n=%3d  along p10/p50/p90 = %5s / %5s / %5s m  dist p50 = %s m  before_line(along<0) = %.2f' % (
+            kind or 'all', len(sel), q(al, .1), q(al, .5), q(al, .9), q([r['dist'] for r in sel], .5),
+            sum(a < 0 for a in al) / len(al)))
+
+
+if __name__ == '__main__':
+    main()
