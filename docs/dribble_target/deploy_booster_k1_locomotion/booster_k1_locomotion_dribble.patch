@@ -0,0 +1,40 @@
+"""ドリブルテスト用: k1_isaaclab_sim.launch.py を UFO 起き上がり無効 (ufo_*_path='') で起動する.
+ros2 launch の CLI は空文字の引数 (name:=) を受け付けないため, include 側で空文字を渡す.
+使い方: ros2 launch <this file> dribble_model_path:=<onnx> [他は k1_isaaclab_sim.launch.py と同じ]
+
+既定ではボール検出の視野制限と位置ノイズを切る (AMP キックのテストと同じ). まずポリシー自体が
+経路をたどれるかを見るため. 実機寄りの条件で見るときは
+    ball_detection_only_in_camera_fov:=true detection_position_noise:=true
+を付ける (足元のボールが視野から外れると 1 秒で Walk に戻る).
+"""
+import os
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.substitutions import LaunchConfiguration
+
+
+def generate_launch_description():
+    sim_launch = os.path.join(get_package_share_directory("booster_k1_locomotion"),
+                              "launch", "k1_isaaclab_sim.launch.py")
+    # xml_path: 空なら既定のフィールド. ボールの物理などを変えた XML で A/B するときに渡す.
+    # self_position_delay_ms / detection_delay_ms: 自己位置・ボール検出の遅れ [ms] (既定 0)。
+    # 5v5_game.sh の試合構成は 170 / 100。
+    forwarded = ["dribble_model_path", "action_delay_ticks", "headless", "xml_path",
+                 "ball_detection_only_in_camera_fov", "detection_position_noise",
+                 "self_position_delay_ms", "detection_delay_ms", "dribble_ball_world_source",
+                 "log_ball_contacts"]
+    defaults = {"action_delay_ticks": "1", "headless": "true",
+                "ball_detection_only_in_camera_fov": "false", "detection_position_noise": "false",
+                "self_position_delay_ms": "0.0", "detection_delay_ms": "0.0",
+                "dribble_ball_world_source": "filter", "log_ball_contacts": "false"}
+    return LaunchDescription(
+        [DeclareLaunchArgument(a, default_value=defaults.get(a, "")) for a in forwarded]
+        + [IncludeLaunchDescription(
+            PythonLaunchDescriptionSource(sim_launch),
+            launch_arguments={
+                "use_cpp_sim": "true", "use_cpp_policy": "true", "start_active": "true",
+                "ufo_model_path": "", "ufo_z_bank_path": "",
+                **{a: LaunchConfiguration(a) for a in forwarded},
+            }.items())])
