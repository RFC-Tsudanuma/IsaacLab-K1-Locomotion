@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# ドリブルの MuJoCo テスト一式:
+#   MuJoCo sim (headless, C++ policy, dribble) + vision_filter (id 1) を上げ、
+#   test_dribble_mujoco.py でいくつかの経路をドリブルさせ、集計を出す。
+# 使い方: run_dribble_mujoco_test.sh [<dribble_model.onnx>] [test_dribble_mujoco.py の追加引数...]
+#   モデル省略時はパッケージの assets にある既定のモデルを使う。
+#   SIM_ARGS で dribble_test_sim.launch.py に引数を足せる
+#   (例: SIM_ARGS="ball_detection_only_in_camera_fov:=true detection_position_noise:=true")。
+set -o pipefail  # -u は ROS の setup.bash と相性が悪い
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+WS="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+MODEL="$SCRIPT_DIR/../assets/k1_dribble_target_2026-11-01_12-04-42_model_74991.onnx"
+if [[ $# -gt 0 && "$1" == *.onnx ]]; then MODEL="$1"; shift; fi
+MODEL="$(realpath "$MODEL")"
+LOG="${LOG_DIR:-/tmp/dribble_test}"; mkdir -p "$LOG"
+source /opt/ros/humble/setup.bash
+source "$WS/install/setup.bash"
+
+pkill -f mujoco_sim_node_cpp 2>/dev/null; pkill -f rl_policy_isaaclab_node_cpp 2>/dev/null; pkill -f vision_filter_node 2>/dev/null; sleep 1
+
+ros2 launch "$SCRIPT_DIR/dribble_test_sim.launch.py" dribble_model_path:="$MODEL" ${SIM_ARGS:-} > "$LOG/sim.log" 2>&1 &
+SIM_PID=$!
+sleep 6
+ros2 launch vision_filter vision_filter.launch.py sim_robot_id:=1 > "$LOG/vision_filter.log" 2>&1 &
+VF_PID=$!
+sleep 4
+python3 "$SCRIPT_DIR/test_dribble_mujoco.py" "$@" 2>&1 | tee "$LOG/test.log"
+RC=${PIPESTATUS[0]}
+kill $VF_PID $SIM_PID 2>/dev/null; sleep 2
+pkill -f mujoco_sim_node_cpp 2>/dev/null; pkill -f rl_policy_isaaclab_node_cpp 2>/dev/null; pkill -f vision_filter_node 2>/dev/null
+echo "TEST_EXIT=$RC (logs in $LOG; policy log: grep Dribble $LOG/sim.log)"
+exit $RC
