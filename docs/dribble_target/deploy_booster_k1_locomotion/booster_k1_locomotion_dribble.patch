+        if (step_count_ % 25 == 1) {
+            RCLCPP_INFO(logger_,
+                "[Dribble step %d] wp %zu/%zu target_rel=(%.2f,%.2f) ball=(%.2f,%.2f)%s "
+                "ball_goal=%.2f robot_goal=%.2f robot field (%.2f,%.2f,%.1f°)",
+                step_count_, wp_idx_ + 1, path_.size(), frame[49], frame[50],
+                ball.x, ball.y, tracked ? "" : " (lost)", ball_goal, robot_goal,
+                state.field_x, state.field_y, state.field_yaw * 180.0 / M_PI);
+        }
+        return cmd;
+    }
+
+    bool is_finished() const override { return finished_; }
+    int step_count() const override { return step_count_; }
+    LegArray last_action_walk_units() const override { return prev_actions_; }
+
+private:
+    std::optional<MotorCommand> finish(const char* why) {
+        RCLCPP_INFO(logger_, "[Dribble] %s at step %d (waypoint %zu/%zu) — switching to WALK",
+                    why, step_count_, wp_idx_ + 1, path_.size());
+        finished_ = true;
+        return std::nullopt;
+    }
+
+    // Body-yaw-frame xy (vision) → field frame, with the latest /localization_result.
+    static std::array<double, 2> body_to_field(const RobotState& s, double x, double y) {
+        const double c = std::cos(s.field_yaw), sn = std::sin(s.field_yaw);
+        return {s.field_x + c * x - sn * y, s.field_y + sn * x + c * y};
+    }
+    // Field-frame point → body yaw frame, relative to the robot.
+    static std::array<double, 2> field_to_body(const RobotState& s, double wx, double wy) {
+        const double c = std::cos(s.field_yaw), sn = std::sin(s.field_yaw);
+        const double dx = wx - s.field_x, dy = wy - s.field_y;
+        return {c * dx + sn * dy, -sn * dx + c * dy};
+    }
+
+    // foot_link origin in the body yaw frame: leg FK gives it in the trunk
+    // frame, which still carries roll/pitch; rotate those out.
+    static std::array<double, 2> foot_xy_yaw_frame(const RobotState& s, bool left) {
+        double q6[6];
+        const int base = LEG_INDEX_BEGIN + (left ? 0 : POLICY_NUM_DOF / 2);
+        for (int i = 0; i < 6; ++i) q6[i] = s.joint_pos[base + i];
+        const auto p = leg_fk_foot_pos(q6, left);
+        const double rp0[3] = {s.imu_rpy[0], s.imu_rpy[1], 0.0};
+        double q[4];
+        rpy_to_quat(rp0, q);
+        // R(q) * v == rotate_inverse(conj(q), v)
+        const double q_conj[4] = {q[0], -q[1], -q[2], -q[3]};
+        double out[3];
+        quat_rotate_inverse(q_conj, p.data(), out);
+        return {out[0], out[1]};
+    }
+
+    void build_frame(const RobotState& state, const BallObs& ball, float* frame) {
+        double q[4];
+        rpy_to_quat(state.imu_rpy.data(), q);
+        const double g_world[3] = {0.0, 0.0, -1.0};
+        double pg[3];
+        quat_rotate_inverse(q, g_world, pg);
+
+        int idx = 0;
+        for (int i = 0; i < 3; ++i) frame[idx++] = static_cast<float>(state.imu_gyro[i]);
+        for (int i = 0; i < 3; ++i) frame[idx++] = static_cast<float>(pg[i]);
+        for (int i = 0; i < 3; ++i) frame[idx++] = 0.0f;  // velocity_commands
+        for (int i = 0; i < POLICY_NUM_DOF; ++i)
+            frame[idx++] = static_cast<float>(state.joint_pos[LEG_INDEX_BEGIN + i] - default_angles_legs_[i]);
+        for (int i = 0; i < POLICY_NUM_DOF; ++i)
+            frame[idx++] = static_cast<float>(state.joint_vel[LEG_INDEX_BEGIN + i]);
+        for (int i = 0; i < POLICY_NUM_DOF; ++i)
+            frame[idx++] = static_cast<float>(prev_actions_[i]);
+        // Gait phase: emit, then advance (same order as the walk).
+        frame[idx++] = static_cast<float>(std::sin(phase_rad_));
+        frame[idx++] = static_cast<float>(std::cos(phase_rad_));
+        frame[idx++] = static_cast<float>(std::sin(phase_rad_ + M_PI));
+        frame[idx++] = static_cast<float>(std::cos(phase_rad_ + M_PI));
+        phase_rad_ = std::fmod(phase_rad_ + 2.0 * M_PI * db::GAIT_FREQ_HZ * step_dt_, 2.0 * M_PI);
+
+        const auto& w = path_[wp_idx_];
+        const auto target = field_to_body(state, w[0], w[1]);
+        frame[idx++] = static_cast<float>(target[0]);
+        frame[idx++] = static_cast<float>(target[1]);
+        frame[idx++] = static_cast<float>(ball.x);
+        frame[idx++] = static_cast<float>(ball.y);
+        frame[idx++] = static_cast<float>(ball.vel_valid ? ball.vx : 0.0);
+        frame[idx++] = static_cast<float>(ball.vel_valid ? ball.vy : 0.0);
+        for (const bool left : {true, false}) {
+            const auto foot = foot_xy_yaw_frame(state, left);
+            frame[idx++] = static_cast<float>(ball.x - foot[0]);
+            frame[idx++] = static_cast<float>(ball.y - foot[1]);
+        }
+    }
+
+    void push_history(const float* frame) {
+        const int64_t H = io_.history_len;
+        if (!history_primed_) {
+            for (int64_t t = 0; t < H; ++t) {
+                std::copy(frame, frame + db::OBS_DIM, history_.data() + t * db::OBS_DIM);
+            }
+            history_primed_ = true;
+            return;
+        }
+        std::memmove(history_.data(), history_.data() + db::OBS_DIM,
+                     static_cast<size_t>((H - 1) * db::OBS_DIM) * sizeof(float));
+        std::copy(frame, frame + db::OBS_DIM, history_.data() + (H - 1) * db::OBS_DIM);
+    }
+
+    Ort::Session* session_;
+    DribblePolicyIO io_;
+    std::shared_ptr<WalkRLPolicyBehavior> walk_;
+    JointArray default_angles_;
+    LegArray   default_angles_legs_{};
+    double     step_dt_;
+    KickThresholds kick_th_;
+    JointArray relux_kp_;
+    JointArray relux_kd_;
+    rclcpp::Logger logger_;
+
+    std::vector<float> history_;   // H × 59, oldest first
+    bool history_primed_ = false;
+    LegArray prev_actions_{};
+    double phase_rad_ = 0.0;
+    std::vector<std::array<double, 2>> path_;  // field frame, last = goal
+    uint32_t path_seq_ = 0;
+    bool have_path_ = false;
+    size_t wp_idx_ = 0;
+    std::array<double, 2> prev_point_{};       // P of the pass rule (field frame)
+    int  last_path_log_step_ = 0;
+    bool ball_world_from_filter_ = true;
+    int  step_count_ = 0;
+    int  lost_ticks_ = 0;
+    bool finished_ = false;
+};
