+    // true: judge waypoints / goal with vision_filter's field-frame ball (times
+    // match). false: latest localization + body-frame ball (the two are from
+    // different times, ~200 ms apart; kept for A/B).
+    void set_ball_world_from_filter(bool v) { ball_world_from_filter_ = v; }
+
+    void on_enter(const RobotState& state) override {
+        step_count_ = 0;
+        lost_ticks_ = 0;
+        finished_ = false;
+        history_primed_ = false;
+        have_path_ = false;
+        path_.clear();
+        wp_idx_ = 0;
+        // The walk's last command is what the robot is executing right now; it
+        // becomes the first last_action channel.
+        prev_actions_ = walk_ ? walk_->last_action() : LegArray{};
+        const auto gait = walk_ ? walk_->gait_phase_state()
+                                : WalkRLPolicyBehavior::GaitPhaseState{};
+        phase_rad_ = gait.active ? gait.phase_rad : 0.0;
+        RCLCPP_INFO(logger_,
+            "[Dribble] enter: gait clock %s (phase %.2f rad), robot field (%.2f, %.2f, %.1f°)",
+            gait.active ? "inherited from Walk" : "started at 0", phase_rad_,
+            state.field_x, state.field_y, state.field_yaw * 180.0 / M_PI);
+    }
+
+    // The history starts from the entry frame (episode-reset convention), so
+    // nothing has to be collected while walking.
+    void observe_walk_tick(const RobotState&, const ControlInput&, const LegArray&) override {}
+    void invalidate_history() override {}
+
+    std::optional<MotorCommand> step(const RobotState& state,
+                                     const ControlInput& in) override {
+        ++step_count_;
+        const BallObs& ball = in.ball;
+
+        if (trunk_tilted(state)) {
+            prev_actions_.fill(0.0);
+            history_primed_ = false;
+            MotorCommand fall_cmd;
+            fall_cmd.q = state.joint_pos;
+            fall_cmd.kp = relux_kp_;
+            fall_cmd.kd = relux_kd_;
+            fall_cmd.use_default_gains = false;
+            return fall_cmd;
+        }
+
+        // The training judges waypoints with the true ball position; the closest
+        // thing here is the filter's field-frame estimate.
+        const std::array<double, 2> ball_w =
+            (ball_world_from_filter_ && ball.global_valid)
+                ? std::array<double, 2>{ball.gx, ball.gy}
+                : body_to_field(state, ball.x, ball.y);
+
+        // ── Path (re)start: entry, or a materially different path ──
+        if (!in.kick.dribble_path.empty() &&
+            (!have_path_ || in.kick.dribble_path_seq != path_seq_)) {
+            path_ = in.kick.dribble_path;
+            path_seq_ = in.kick.dribble_path_seq;
+            wp_idx_ = 0;
+            prev_point_ = ball_w;  // P of the first waypoint = ball when the path arrived
+            // A goal that moves with the ball changes the path every few ticks;
+            // log the start and at most once a second after that.
+            if (!have_path_ || step_count_ - last_path_log_step_ >= 50) {
+                RCLCPP_INFO(logger_,
+                    "[Dribble] %s path: %zu waypoints, goal (%.2f, %.2f), ball (%.2f, %.2f)",
+                    have_path_ ? "new" : "start", path_.size(),
+                    path_.back()[0], path_.back()[1], ball_w[0], ball_w[1]);
+                last_path_log_step_ = step_count_;
+            }
+            have_path_ = true;
+        }
+        if (!have_path_) {
+            return finish("no path received");
+        }
+
+        // ── Hand back to Walk (training terminations + deployment guards) ──
+        const bool tracked = ball.mask > 0.5f;
+        lost_ticks_ = tracked ? 0 : lost_ticks_ + 1;
+        if (lost_ticks_ * step_dt_ >= kick_th_.dribble_ball_lost_s) {
+            return finish("ball lost");
+        }
+        if (tracked && ball.dist() > db::BALL_TOO_FAR_M) {
+            return finish("ball too far");
+        }
+        const auto& goal = path_.back();
+        const double ball_goal = std::hypot(ball_w[0] - goal[0], ball_w[1] - goal[1]);
+        const double robot_goal = std::hypot(state.field_x - goal[0], state.field_y - goal[1]);
+        // 学習 (terminations.ball_reached_target) と同じく、最後のウェイポイントに進んでからだけ判定する。
+        // 終点が途中の点の近くを通る経路 (O 字・8 の字は終点 = 始点) で、走る前に終わらないように。
+        const bool at_final_waypoint = wp_idx_ + 1 >= path_.size();
+        if (tracked && at_final_waypoint &&
+            ball_goal < db::SUCCESS_RADIUS_M && robot_goal < db::SUCCESS_RADIUS_M) {
+            return finish("goal reached");
+        }
+        if (step_count_ * step_dt_ >= kick_th_.dribble_timeout_s) {
+            return finish("timeout");
+        }
+
+        // ── Waypoint pass rule (spec waypoints.pass_rule) ──
+        if (tracked && wp_idx_ + 1 < path_.size()) {
+            const auto& w = path_[wp_idx_];
+            const double dx = ball_w[0] - w[0], dy = ball_w[1] - w[1];
+            const double dist = std::hypot(dx, dy);
+            const double ux = w[0] - prev_point_[0], uy = w[1] - prev_point_[1];
+            const double seg = std::hypot(ux, uy);
+            const bool reached = dist < db::WAYPOINT_REACH_M;
+            const bool crossed = seg > 1e-6 && dist < db::PASS_LINE_MAX_M &&
+                                 (dx * ux + dy * uy) >= 0.0;
+            if (reached || crossed) {
+                prev_point_ = w;
+                ++wp_idx_;
+                RCLCPP_INFO(logger_, "[Dribble] waypoint %zu/%zu passed (%s, %.2f m)",
+                            wp_idx_, path_.size(), reached ? "reached" : "crossed", dist);
+            }
+        }
+
+        // ── Observation ──
+        std::array<float, db::OBS_DIM> frame{};
+        build_frame(state, ball, frame.data());
+        push_history(frame.data());
+
+        // ── Inference ──
+        static Ort::MemoryInfo mem =
+            Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+        std::array<float, db::CMD_DIM> command_in{};  // always 0 (Stage2)
+        const std::array<int64_t, 2> cmd_shape = {1, db::CMD_DIM};
+        const std::array<int64_t, 3> hist_shape = {1, io_.history_len, db::OBS_DIM};
+        std::array<Ort::Value, 2> inputs = {
+            Ort::Value::CreateTensor<float>(mem, command_in.data(), command_in.size(),
+                                            cmd_shape.data(), cmd_shape.size()),
+            Ort::Value::CreateTensor<float>(mem, history_.data(), history_.size(),
+                                            hist_shape.data(), hist_shape.size()),
+        };
+        const char* input_names[] = {"command", "obs_history"};
+        const char* output_names[] = {"actions"};
+        auto outputs = session_->Run(Ort::RunOptions{nullptr}, input_names, inputs.data(),
+                                     inputs.size(), output_names, 1);
+        const float* raw = outputs[0].GetTensorData<float>();
+
+        MotorCommand cmd;
+        cmd.q = default_angles_;
+        cmd.use_default_gains = true;
+        for (int i = 0; i < POLICY_NUM_DOF; ++i) {
+            const double a = std::clamp(static_cast<double>(raw[i]),
+                                        -db::ACTION_CLIP, db::ACTION_CLIP);
+            prev_actions_[i] = a;
+            cmd.q[LEG_INDEX_BEGIN + i] = default_angles_legs_[i] + db::ACTION_SCALE * a;
+        }
