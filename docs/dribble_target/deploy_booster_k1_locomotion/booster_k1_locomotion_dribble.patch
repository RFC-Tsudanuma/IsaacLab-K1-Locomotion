+          relux_kp_(relux_kp), relux_kd_(relux_kd), logger_(logger) {
+        static_assert(db::WALK_FRAME_DIM == POLICY_OBS_DIM,
+                      "dribble frame must start with the walk frame");
+        static_assert(db::ACTION_SCALE == POLICY_ACTION_SCALE,
+                      "dribble action scale must match walk");
+        for (int i = 0; i < POLICY_NUM_DOF; ++i) {
+            default_angles_legs_[i] = default_angles_[LEG_INDEX_BEGIN + i];
+        }
+        history_.assign(static_cast<size_t>(io_.history_len) * db::OBS_DIM, 0.0f);
+    }
